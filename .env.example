# Public (bundled into the browser build)
VITE_SUPABASE_URL=https://plzbbfoteevfpqxspyxi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secrets — Netlify Functions only (generate with `npm run keys:generate`, never commit)
PQ_KEM_SECRET_SEED=base64-32-bytes
PQ_SIGN_SEED=base64-32-bytes

# iBanks / payments (Netlify Functions only, never in the browser or apps)
# Same value as the Supabase Vault secret 'ibanks_provider_webhook_secret' (>= 32 random characters).
IBANKS_PROVIDER_WEBHOOK_SECRET=
# 'sandbox' enables the labelled payment simulator (/api/payments/sandbox). Leave unset to disable it.
PAYMENTS_MODE=sandbox
# Optional runtime AI for Ask iBanks: none (default, rules only) | anthropic (needs ANTHROPIC_API_KEY + worker opt-in)
IBANKS_LLM_PROVIDER=none
IBANKS_LLM_MODEL=claude-opus-5-5
# Earn My Goal memory — server only. See docs/GRAPHITI_LOCAL.md.
# Local development: http://127.0.0.1:8787; production needs an authenticated HTTPS service.
GRAPHITI_SERVICE_URL=
GRAPHITI_SERVICE_TOKEN=
# FNB adapters stay disabled; they refuse even when these are set until the integration contract is implemented.
# FNB_PAYSHAP_API_ACCESS_APPROVED= FNB_PAYSHAP_AGREEMENT_REF= FNB_PAYSHAP_VERIFIED_TEST_RUN= FNB_PAYSHAP_CLIENT_ID=
